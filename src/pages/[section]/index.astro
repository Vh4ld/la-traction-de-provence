---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { pageRoute, sectionChildren } from '../../lib/pages';

export async function getStaticPaths() {
  /** Rubriques ayant leur propre page (src/pages/<rubrique>/index.astro). */
  const CUSTOM = new Set(['photo-du-mois']);
  const pages = await getCollection('pages');
  return pages
    .map((entry) => ({ entry, route: pageRoute(entry.filePath!) }))
    .filter(({ route }) => !route.slug && !CUSTOM.has(route.section))
    .map(({ entry, route }) => ({
      params: { section: route.section },
      props: { entry, children: sectionChildren(pages, route.section) },
    }));
}

const { entry, children } = Astro.props;
const { Content } = await render(entry);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  section={entry.data.section}
  cover={entry.data.cover}
  siblings={children}
>
  <Content />
</ArticleLayout>
