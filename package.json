  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview --port 4321",
    "astro": "astro",
    "test:unit": "vitest run",
    "test:links": "linkinator dist --recurse --skip \"^https?://(?!localhost|127\\\\.0\\\\.0\\\\.1)\"",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run build && npm run test:links && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/limelight": "^5.3.0",
    "@types/hast": "^3.0.5",
    "astro": "^7.4.5",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/turndown": "^5.0.6",
    "cheerio": "^1.2.0",
    "happy-dom": "^21.0.4",
    "linkinator": "^8.1.0",
    "sirv-cli": "^3.0.1",
    "tsx": "^4.23.15",
    "turndown": "^7.2.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "linkinator": {
      "glob": "^14.0.4"
    }
